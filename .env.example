DATABASE_URL=postgresql://opendocs:opendocs@localhost:55432/opendocs
BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET=change-me
GITHUB_CLIENT_ID=dummy
GITHUB_CLIENT_SECRET=dummy

# Storage: "local" (default), "s3" or "drive"
STORAGE_PROVIDER=local
# local provider
LOCAL_STORAGE_DIR=/tmp/opendocs-storage
# s3 provider (S3-compatible: AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT=<s3-endpoint-url>
S3_REGION=auto
S3_ACCESS_KEY_ID=<s3-access-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key>
S3_BUCKETS=<bucket-one>,<bucket-two>
# drive provider (Google Drive; OAuth refresh token per account, scope drive.file,
# NOT a service account: service accounts have no storage quota)
DRIVE_CLIENT_ID=<google-oauth-client-id>
DRIVE_CLIENT_SECRET=<google-oauth-client-secret>
DRIVE_ACCOUNTS=[{"name":"staging","refreshToken":"<refresh-token>","folderId":"<folder-id>"}]
# AC-21 per-workspace storage connections: 32-byte AES-256 key (hex or base64),
# encrypts StorageConnection.secret (Drive refresh token, S3 key pair).
STORAGE_SECRET_KEY=<32-byte-key-hex-or-base64>

# Tenant site addresses ({slug}.TENANT_BASE_DOMAIN). Unset or empty disables tenant
# routing entirely: every route then behaves exactly as it does today.
TENANT_BASE_DOMAIN=
# Platform admin allow-list (legacy fallback for migration to User.staffRole model in AC-34).
# Comma-separated emails auto-promoted to staffRole='admin' on first access.
PLATFORM_ADMIN_EMAILS=
# Set to "true" to disable legacy auto-promotion once migration verification passes.
PLATFORM_ADMIN_FALLBACK_DISABLED=

# 24+ chars, dev only, never production
E2E_LOGIN_ENABLED=false
E2E_LOGIN_TOKEN=

# Billing & Polar (AC-28, UI-A18)
BILLING_READY=false
POLAR_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=
POLAR_PRODUCT_CREDITS_1000=
POLAR_PRODUCT_CREDITS_5000=
POLAR_PRODUCT_CREDITS_20000=
