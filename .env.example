# OpenDocs api configuration. Copy to .env and fill in. Values below are examples only.
# [required] vars must be set or the api refuses to start and names every bad var.

# --- Core ---------------------------------------------------------------------
# [required] PostgreSQL connection URL.
DATABASE_URL=postgresql://opendocs:opendocs@localhost:5432/opendocs
# [required] Public origin of this instance: absolute http(s) URL, no path. OAuth callbacks,
# doc links and image links are built from it. The api is reached at ${PUBLIC_URL}/api.
PUBLIC_URL=http://localhost:3000
# [required] Session signing secret, at least 32 characters (for example: openssl rand -hex 32).
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Port the api listens on. Default 4000.
PORT=4000
# Name of the site and of the single workspace. Default OpenDocs.
SITE_NAME=OpenDocs

# --- Accounts -----------------------------------------------------------------
# [required] Comma list of admin emails. The very first user to sign in is always the owner;
# after that these emails are admins and everyone else is an editor.
ADMIN_EMAILS=admin@example.com
# true or false. Unset = open until the first user exists, then closed. An email in
# ADMIN_EMAILS can always sign in.
ALLOW_SIGNUP=
# GitHub OAuth app (callback: ${PUBLIC_URL}/api/auth/callback/github). Set both or neither.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Storage (S3-compatible: MinIO, AWS S3, Cloudflare R2, Backblaze B2) ------
# [required] Endpoint URL of the S3 service. MinIO example below.
S3_ENDPOINT=http://localhost:9000
# [required] One bucket for every image. Create it before the first upload.
S3_BUCKET=opendocs
# [required] Access key pair (MinIO defaults shown, change them).
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Region. Default us-east-1 (R2 uses auto).
S3_REGION=us-east-1
# true for MinIO and most self-hosted S3 (path-style URLs), false for AWS S3 and R2. Default false.
S3_FORCE_PATH_STYLE=true
# Optional key prefix inside the bucket, for example opendocs/.
S3_PREFIX=
# Optional public base URL for images (a CDN or a public bucket URL). When set, image links
# point straight at ${ASSET_BASE_URL}/${S3_PREFIX}<object key>; when empty, images are
# served through the api at ${PUBLIC_URL}/api/i/<id>.
ASSET_BASE_URL=

# --- Limits -------------------------------------------------------------------
# Max steps in one recording. Default 15.
MAX_STEPS_PER_RUN=15
# Max size of one uploaded image in bytes. Default 10485760 (10 MiB).
MAX_UPLOAD_BYTES=10485760
# Cap on total live step-image bytes. Default 0 (no cap).
STORAGE_QUOTA_BYTES=0
# Days a step image of an uncompiled recording is kept. Default 7.
DRAFT_IMAGE_DAYS=7

# --- Ask AI (optional; off while AI_API_KEY is empty) -------------------------
# OpenAI-compatible API root. Default https://api.openai.com/v1.
AI_BASE_URL=https://api.openai.com/v1
# Setting a key turns the public "Ask AI" panel on.
AI_API_KEY=
# [required when AI_API_KEY is set] Model name sent to {AI_BASE_URL}/chat/completions.
AI_MODEL=
# Max questions per chat session per UTC day. Default 10, 0 = unlimited.
AI_DAILY_MESSAGE_LIMIT=10

# --- Alerts (optional) --------------------------------------------------------
# Telegram message once a day when the storage cap is hit. Set both or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Test only ----------------------------------------------------------------
# Browser test login bypass. Never enable in production. The token needs 24+ characters.
E2E_LOGIN_ENABLED=false
E2E_LOGIN_TOKEN=
