# ==============================================================================
# OpenDocs API Container (Dockerfile.api)
#
# Build command:
#   docker build -f Dockerfile.api -t opendocs-api:<tag> .
#
# Build arguments:
#   BUN_VERSION              Bun version to use (default: 1.4.2)
#
# Required runtime environment variables:
#   DATABASE_URL             PostgreSQL connection URL (e.g. postgresql://user:pass@host:5432/opendocs)
#   BETTER_AUTH_SECRET       Secret encryption key for Better-Auth authentication
#   BETTER_AUTH_URL          Canonical public base URL (e.g. https://opendocs.example.com or http://localhost:3100)
#   GITHUB_CLIENT_ID         GitHub OAuth Client ID for authentication
#   GITHUB_CLIENT_SECRET     GitHub OAuth Client Secret for authentication
#
# Optional runtime environment variables:
#   PORT                     Port for API HTTP server (default: 4000)
#   STORAGE_PROVIDER         Asset storage driver: "local" (default), "s3", or "drive"
#   LOCAL_STORAGE_DIR        Local upload directory when STORAGE_PROVIDER=local (default: /tmp/opendocs-storage)
#   STORAGE_SECRET_KEY       32-byte AES-256 key (hex or base64) for workspace storage credentials encryption
#   S3_ENDPOINT              S3-compatible endpoint URL (when STORAGE_PROVIDER=s3)
#   S3_REGION                S3 region (default: auto)
#   S3_ACCESS_KEY_ID         S3 access key ID
#   S3_SECRET_ACCESS_KEY     S3 secret access key
#   S3_BUCKETS               Comma-separated list of S3 bucket names
#   DRIVE_CLIENT_ID          Google Drive OAuth client ID (when STORAGE_PROVIDER=drive)
#   DRIVE_CLIENT_SECRET      Google Drive OAuth client secret
#   DRIVE_ACCOUNTS           JSON array of Google Drive account configurations
#   TENANT_BASE_DOMAIN       Base domain for tenant site routing ({slug}.TENANT_BASE_DOMAIN)
#   PLATFORM_ADMIN_EMAILS    Comma-separated list of admin emails for auto-promotion
#   PLATFORM_ADMIN_FALLBACK_DISABLED Set to "true" to disable legacy auto-promotion
#   BILLING_READY            Set to "true" to enable Polar billing integration
#   POLAR_WEBHOOK_SECRET     Polar webhook signature verification secret
#   POLAR_ACCESS_TOKEN       Polar API access token
#   POLAR_PRODUCT_*          Polar product IDs (PRO_MONTHLY, PRO_YEARLY, CREDITS_*)
#   TELEGRAM_BOT_TOKEN       Telegram bot token for quota alerts
#   TELEGRAM_CHAT_ID         Telegram chat ID for quota alerts
# ==============================================================================

ARG BUN_VERSION=1.4.2
FROM oven/bun:${BUN_VERSION}

WORKDIR /app

# Copy the monorepo (packages/core is linked into apps through bun workspaces)
COPY . /app

# Install dependencies using frozen lockfile
RUN bun install --frozen-lockfile

# Generate Prisma Client for apps/api
WORKDIR /app/apps/api
RUN bun run prisma:generate

# Set permissions and prepare entrypoint
RUN chmod +x /app/docker/api-entrypoint.sh && \
    chown -R bun:bun /app

USER bun
EXPOSE 4000

ENV PORT=4000
ENV NODE_ENV=production

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:' + (process.env.PORT || '4000') + '/api/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["/app/docker/api-entrypoint.sh"]
