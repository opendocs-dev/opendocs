# ==============================================================================
# OpenDocs API Container (Dockerfile.api)
#
# Build command:
#   docker build -f Dockerfile.api -t opendocs-api:<tag> .
#
# Build arguments:
#   BUN_VERSION              Bun version to use (default: 1.4.2)
#
# Required runtime environment variables (the api exits at boot, naming every bad one):
#   DATABASE_URL             PostgreSQL connection URL (e.g. postgresql://user:pass@host:5432/opendocs)
#   PUBLIC_URL               Public origin of the instance (absolute http(s) URL, no path)
#   BETTER_AUTH_SECRET       Session signing secret, at least 32 characters
#   ADMIN_EMAILS             Comma list of admin emails (the first user to sign in is the owner)
#   S3_ENDPOINT              S3-compatible endpoint URL
#   S3_BUCKET                Bucket for all images
#   S3_ACCESS_KEY_ID         S3 access key id
#   S3_SECRET_ACCESS_KEY     S3 secret access key
#
# Optional runtime environment variables (see apps/api/.env.example for the full list):
#   PORT, SITE_NAME, ALLOW_SIGNUP, GITHUB_CLIENT_ID/GITHUB_CLIENT_SECRET,
#   S3_REGION, S3_FORCE_PATH_STYLE, S3_PREFIX, ASSET_BASE_URL,
#   MAX_STEPS_PER_RUN, MAX_UPLOAD_BYTES, STORAGE_QUOTA_BYTES, DRAFT_IMAGE_DAYS,
#   AI_BASE_URL, AI_API_KEY, AI_MODEL, AI_DAILY_MESSAGE_LIMIT,
#   TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID
# ==============================================================================

ARG BUN_VERSION=1.4.2
FROM oven/bun:${BUN_VERSION}

WORKDIR /app

# Copy the monorepo (packages/core is linked into apps through bun workspaces)
COPY . /app

# Install dependencies using frozen lockfile
RUN bun install --frozen-lockfile

# Generate Prisma Client for apps/api
WORKDIR /app/apps/api
RUN bun run prisma:generate

# Set permissions and prepare entrypoint
RUN chmod +x /app/docker/api-entrypoint.sh && \
    chown -R bun:bun /app

USER bun
EXPOSE 4000

ENV PORT=4000
ENV NODE_ENV=production

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:' + (process.env.PORT || '4000') + '/api/healthz').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["/app/docker/api-entrypoint.sh"]
